# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo

# Build output
site/

# IDE
.idea/
.vscode/
.project
.classpath

# OS
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp

# Logs
*.log
npm-debug.log*
mkdocs.log

# Cache
.cache/
*.egg-info/

# Environment variables
.env
.env.local
.env.*.local

# MkDocs
*.pyc
*.egg-info/

# 默认忽略 demo / 临时产物中的 HTML/CSS/JS
*.html
*.css
*.js

# 但以下源码 HTML/CSS 须被跟踪：
#   overrides/main.html       - Material 主题 custom_dir
#   docs/stylesheets/extra.css - mkdocs.yml extra_css 引用
# （gitignore 优先级：后面的 ! 规则覆盖前面的 * 规则）
!/overrides/*.html
!/docs/stylesheets/*.css
